+                custom_object_save_target = getattr(unwrap_model, "get_base_model", lambda: unwrap_model)()
+                custom_object_save(custom_object_save_target, hf_config_tokenizer_path, config=model_config)
 
             # Also save runtime FSDP config
             fsdp_config_path = os.path.join(local_path, "fsdp_config.json")
